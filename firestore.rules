rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ============================================================
    // REGLAS PARA DESARROLLO/ASIGNATURA
    // Permiten lectura y escritura sin autenticación.
    //
    // ⚠️ IMPORTANTE: Antes de producción, cámbialas por reglas
    //    autenticadas, por ejemplo:
    //    match /productos/{id} {
    //      allow read, write: if request.auth != null;
    //    }
    // ============================================================

    match /productos/{id} {
      allow read, write: if true;
    }
  }
}
